# SQL Server (MicroK8s) deployment variables
# Copy to .env and set values for your environment. Do NOT commit real passwords.

# Deployment
NAMESPACE=mssql-system
APP_NAME=mssql
IMAGE=mcr.microsoft.com/mssql/server:2022-latest
MSSQL_PID=Developer
PVC_NAME=mssql-data
PVC_SIZE=8Gi
STORAGE_CLASS=
SERVICE_NAME=mssql-svc

# Secrets (runtime only; avoid committing real values)
MSSQL_SA_PASSWORD=CHANGE_ME_STRONG_PASSWORD