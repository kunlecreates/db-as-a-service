# Oracle Single Instance Database (Oracle Database Operator) deployment variables
# Copy to .env and set values for your environment. Do NOT commit real passwords.

NAMESPACE=oracle-system
SIDB_NAME=oracledb
EDITION=free
SID=FREE
PDB_NAME=FREEPDB1

# Image
IMAGE_PULL_FROM=container-registry.oracle.com/database/free:23.3.0
IMAGE_PULL_SECRET=ocr-pull-secret

# OCI registry credentials (if docker config not provided)
OCI_REGISTRY_SERVER=container-registry.oracle.com
OCI_REGISTRY_USERNAME=
OCI_REGISTRY_PASSWORD=
OCI_REGISTRY_EMAIL=

# Storage
STORAGE_SIZE=8Gi
STORAGE_CLASS=
ACCESS_MODE=ReadWriteOnce
REPLICAS=1

# Operator/cert-manager
INSTALL_CERT_MANAGER=true
CERT_MANAGER_NAMESPACE=cert-manager-system
CERT_MANAGER_VERSION=v1.19.1
CERT_MANAGER_METHOD=helm
OPERATOR_NAMESPACE=oracle-database-operator-system
SKIP_OPERATOR_INSTALL=false

# Secrets (runtime only)
ORACLE_PWD=CHANGE_ME_STRONG_PASSWORD
DOCKER_CONFIG_JSON=

# Optional override for Free edition image
IMAGE_PULL_FROM_FREE_OVERRIDE=container-registry.oracle.com/database/free:latest