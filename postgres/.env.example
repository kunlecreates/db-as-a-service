# PostgreSQL (Bitnami Helm) deployment variables
# Copy to .env and set values for your environment. Do NOT commit real passwords.

NAMESPACE=postgres-system
HA=false
CHART_NAME=oci://registry-1.docker.io/bitnamicharts/postgresql
CHART_VERSION=
PVC_SIZE=8Gi
STORAGE_CLASS=
SERVICE_TYPE=ClusterIP

# Registry (optional)
DOCKERHUB_USERNAME=
DOCKERHUB_PASSWORD=
IMAGE_REGISTRY=docker.io
ALLOW_INSECURE_IMAGES=false

# Secrets (runtime only)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD