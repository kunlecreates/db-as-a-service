# MySQL InnoDBCluster (MySQL Operator) deployment variables
# Copy to .env and set values for your environment. Do NOT commit real passwords.

NAMESPACE=mysql-system
CLUSTER_NAME=mysql
SECRET_NAME=mysql-cluster-secret
INSTANCES=1
ROUTER_INSTANCES=1
MYSQL_VERSION=8.4.0
PVC_NAME=mysql-backups
STORAGE_SIZE=8Gi
STORAGE_CLASS=
BACKUP_PROFILE_NAME=pvc-backups
SERVICE_TYPE=ClusterIP

# Root credentials (runtime only)
MYSQL_ROOT_USER=root
MYSQL_ROOT_HOST=%
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Operator pins
OPERATOR_CHART_VERSION=2.1.9
OPERATOR_IMAGE_TAG=8.4.0-2.1.3